            neededItem = scanner.nextLine();

            System.out.println("How many do you need?");
            quantity = Integer.parseInt(scanner.nextLine());

            switch (neededItem) {

                case "packed ice" -> {
                    ice = 9;

                    neededIce = quantity * ice;
                }

                case "blue ice" -> {
                    ice = 81;

                    neededIce = quantity * ice;
                }

                case "compass" -> {
                    ironIngot = 4;
                    redstone = 1;

                    neededIronIngot = quantity * ironIngot;
                    neededRedstone = quantity * redstone;
                }

                case "tnt" -> {
                    sand = 4;
                    gunpowder = 5;

                    neededSand = quantity * sand;
                    neededGunpowder = quantity * gunpowder;
                }

                case "hopper" -> {
                    ironIngot = 5;
                    log = 2;

                    neededIronIngot = quantity * ironIngot;
                    neededLog = quantity * log;
                }

                case "minecart" -> {
                    ironIngot = 5;

                    neededIronIngot = quantity * ironIngot;
                }

                case "minecart with hopper" -> {
                    ironIngot = 10;
                    log = 2;

                    neededIronIngot = quantity * ironIngot;
                    neededLog = quantity * log;
                }

                case "minecart with chest" -> {
                    ironIngot = 5;
                    log = 2;

                    neededIronIngot = quantity * ironIngot;
                    neededLog = quantity * log;
