            else if (neededHay == 64) {
                System.out.println("You need 1 stack of hay");
            }
            else if (neededHay > 0) {
                System.out.println("You need " + neededHay + " hay");
            }
            else if (neededHay < 0) {
                System.out.println("Enter a positive integer");
