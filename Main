                gunpowderRemainder = neededGunpowder % 64;
                System.out.println("You need " + gunpowderStack + " gunpowder stack/s and " + gunpowderRemainder + " gunpowder/s");
            }
            else if (neededGunpowder == 64) {
                System.out.println("You need 1 stack of gunpowder");
            }
            else if (neededGunpowder > 0) {
                System.out.println("You need " + neededGunpowder + " gunpowder/s");
            }
            else if (neededGunpowder < 0) {
                System.out.println("Enter a positive integer");
            }
