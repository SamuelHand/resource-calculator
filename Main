        int quantity = 0;

        int stone = 0;
        int neededStone = 0;
        int stoneStack = 0;
        int stoneRemainder = 0;

        int redstone = 0;
        int neededRedstone = 0;
        int redstoneStack = 0;
        int redstoneRemainder = 0;

        int stick = 0;
        int neededStick = 0;
        int stickStack = 0;
        int stickRemainder = 0;

        int cobblestone = 0;
        int neededCobblestone = 0;
        int cobblestoneStack = 0;
        int cobblestoneRemainder = 0;

        int plank = 0;
        int neededPlanks = 0;
        int plankStack = 0;
        int plankRemainder = 0;

        int log = 0;
        int neededLog = 0;
        int logStack = 0;
        int logRemainder = 0;

        int ice = 0;
        int neededIce = 0;
        int iceStack = 0;
        int iceRemainder = 0;

        int slimeball = 0;
        int neededSlimeball = 0;
        int slimeballStack = 0;
        int slimeballRemainder = 0;

        int quartz = 0;
        int neededQuartz = 0;
        int quartzStack = 0;
        int quartzRemainder = 0;

        int string = 0;
        int neededString = 0;
        int stringStack = 0;
        int stringRemainder = 0;

