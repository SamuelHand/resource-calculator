            else if (neededLog == 64) {
                System.out.println("You need 1 stack of logs");
            }
            else if (neededLog > 0) {
                System.out.println("You need " + neededLog + " log/s");
            }
            else if (neededLog < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededStick > 64) {
                stickStack = neededStick / 64;
                stickRemainder = neededStick % 64;
                System.out.println("You need " + stickStack + " stick stack/s and " + stickRemainder + " stick/s");
            }
            else if (neededStick == 64) {
                System.out.println("You need 1 stack of sticks");
            }
            else if (neededStick > 0) {
                System.out.println("You need " + neededStick + " stick/s");
            }
            else if (neededStick < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededStone > 64) {
                stoneStack = neededStone / 64;
                stoneRemainder = neededStone % 64;
                System.out.println("You need " + stoneStack + " stone stack/s and " + stoneRemainder + " stone");
            }
            else if (neededStone == 64) {
                System.out.println("You need 1 stack of stone");
            }
            else if (neededStone > 0) {
                System.out.println("You need " + neededStone + " stone");
            }
            else if (neededStone < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededIce > 64) {
                iceStack = neededIce / 64;
                iceRemainder = neededIce % 64;
                System.out.println("You need " + iceStack + " ice stack/s and " + iceRemainder + " ice");
            }
            else if (neededIce == 64) {
                System.out.println("You need 1 stack of ice");
            }
            else if (neededIce > 0) {
                System.out.println("You need " + neededIce + " ice");
            }
            else if (neededIce < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededSlimeball > 64) {
                slimeballStack = neededSlimeball / 64;
                slimeballRemainder = neededSlimeball % 64;
                System.out.println("You need " + slimeballStack + " slimeball stack/s and " + slimeballRemainder + " slimeball");
            }
            else if (neededSlimeball == 64) {
                System.out.println("You need 1 stack of slimeballs");
            }
            else if (neededSlimeball > 0) {
                System.out.println("You need " + neededSlimeball + " slimeballs");
            }
            else if (neededSlimeball < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededQuartz > 64) {
                quartzStack = neededQuartz / 64;
                quartzRemainder = neededQuartz % 64;
                System.out.println("You need " + quartzStack + " quartz stack/s and " + quartzRemainder + " quartz");
            }
            else if (neededQuartz == 64) {
                System.out.println("You need 1 stack of quartz");
            }
            else if (neededQuartz > 0) {
                System.out.println("You need " + neededQuartz + " quartz");
            }
            else if (neededQuartz < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededString > 64) {
                stringStack = neededString / 64;
                stringRemainder = neededString % 64;
                System.out.println("You need " + stringStack + " string stack/s and " + stringRemainder + " string");
            }
            else if (neededString == 64) {
                System.out.println("You need 1 stack of string");
            }
            else if (neededString > 0) {
                System.out.println("You need " + neededString + " string");
            }
            else if (neededString < 0) {
                System.out.println("Enter a positive integer");
            }

            if (neededHay > 64) {
                hayStack = neededHay / 64;
                hayRemainder = neededHay % 64;
                System.out.println("You need " + hayStack + " hay stack/s and " + hayRemainder + " hay");
