                redstoneStack = neededRedstone / 64;
                redstoneRemainder = neededRedstone % 64;
                System.out.println("You need " + redstoneStack + " redstone stack/s and " + redstoneRemainder + " redstone");
            }
            else if (neededRedstone == 64) {
                System.out.println("You need 1 stack of redstone");
            }
            else if (neededRedstone > 0) {
                System.out.println("You need " + neededRedstone + " redstone");
